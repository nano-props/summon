{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest", "electron"],
    "paths": {
      "#/*": ["./*"]
    }
  },
  "include": ["src/**/*.test.ts", "renderer/src/**/*.test.ts", "renderer/src/**/*.test.tsx", "vitest.config.ts"]
}
