{
  "name": "summon",
  "version": "0.1.3",
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "description": "macOS app for switching between Ghostty terminal windows",
  "main": "src/main.ts",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names vite,electron \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite --config renderer/vite.config.ts",
    "dev:electron": "bunx wait-on http://localhost:5173 && electron .",
    "build": "vite build --config renderer/vite.config.ts && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "nano",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wait-on": "9.0.10"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "execa": "9.6.1",
    "i18next": "26.2.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.16.0",
    "p-limit": "7.3.0",
    "quick-lru": "7.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "6.1.1",
    "react-i18next": "17.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "write-file-atomic": "8.0.0",
    "zustand": "5.0.13"
  }
}
