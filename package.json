{
  "name": "summon",
  "version": "0.1.2",
  "type": "module",
  "description": "macOS app for switching between Ghostty terminal windows",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun run dev:vite & bun run dev:electron",
    "dev:vite": "vite --config renderer/vite.config.ts",
    "dev:electron": "bunx wait-on http://localhost:5173 && electron .",
    "build": "vite build --config renderer/vite.config.ts && electron-builder --mac"
  },
  "author": "nano",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.1.0",
    "electron-builder": "26.8.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "vite": "8.0.13",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "nano.summon",
    "productName": "Summon",
    "mac": {
      "icon": "icons/summon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "dir"
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "sign": false,
      "hardenedRuntime": false
    },
    "files": [
      "src/**/*",
      "dist-renderer/**/*",
      "icons/**/*"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lodash-es": "4.18.1",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sortablejs": "1.15.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.13"
  }
}
